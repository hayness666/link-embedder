# Link Embedder: public multi-server routing, no per-server settings.
# Do not paste tokens into chat. DISCORD_TOKEN must use an approved secret mechanism.
# Leave both blank in production. Optional local test isolation only:
TEST_GUILD_ID=
TEST_CHANNEL_IDS=
# After explicit approval of EVERY default proxy recipient listed in PRIVACY.md,
# operator may set this to yes. This is a deployment safeguard, not a Discord install gate.
PROVIDER_SHARING_APPROVED=no
# Emergency shutdown only: yes disables EVERY preview. Normal operation uses no.
# This is not a content classifier or a hosting-compliance mode.
PREVIEWS_DISABLED=no
# Defaults: Amazon/YouTube native; other platforms card until sharing approval.
# With approval: Instagram/TikTok/Twitter/Bluesky/Reddit/Twitch/Snapchat proxy defaults.
# Global optional overrides: PLATFORM_MODE=off|card|native|documented-helper-name
# Mastodon supports card/off only, to avoid bypassing unknown content warnings.

# Optional destructive replacement; requires explicit server/channel allowlist.
# See REPOST.md and obtain channel permission/webhook approval before enabling.
REPOST_AS_AUTHOR=no
