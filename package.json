{
  "name": "link-embedder",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "check": "node --check src/providers/snapchat.js && node --check src/edit-post.js && node --check src/short-links.js && node --check src/index.js && node --check src/simple-cards.js && node --check src/manage-post.js && node --check src/ownership.js && node --check src/card-format.js && node --check src/providers/instagram.js && node --check src/previews.js && node --check src/handler.js && node --check src/urls.js && node --check src/config.js && node --check src/adapters.js && node --check src/repost.js",
    "lint:css": "stylelint \"src/website/**/*.css\"",
    "format:css": "prettier --write \"src/website/**/*.css\"",
    "format:check": "prettier --check \"src/website/**/*.css\""
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.9.10",
    "stylelint": "17.16.0"
  },
  "stylelint": {
    "rules": {
      "block-no-empty": true,
      "color-no-invalid-hex": true,
      "declaration-block-no-duplicate-properties": [
        true,
        {
          "ignore": [
            "consecutive-duplicates-with-different-values"
          ]
        }
      ],
      "declaration-block-no-shorthand-property-overrides": true,
      "function-calc-no-unspaced-operator": true,
      "property-no-unknown": true,
      "selector-pseudo-class-no-unknown": true,
      "selector-pseudo-element-no-unknown": true,
      "unit-no-unknown": true,
      "at-rule-no-unknown": true
    }
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "endOfLine": "lf"
  }
}
